# ============================================================
# SpiderPhish - Environment configuration
# Copy this file to .env and fill in your own API keys.
# NEVER commit the real .env file.
# Keys can also be managed at runtime: Settings -> API Configuration
# (they are stored encrypted in config/secure.json, not in code)
# ============================================================

# --- Threat Intelligence API keys ---
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
GREYNOISE_API_KEY=

# --- General ---
SPIDERPHISH_DEMO_MODE=1
SPIDERPHISH_LOG_LEVEL=INFO
SPIDERPHISH_DB_PATH=data/spiderphish.db
SPIDERPHISH_REPORT_PATH=reports
SPIDERPHISH_CASE_DIR=cases

